{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Static site (ruby)",
      "runtimeExecutable": "ruby",
      "runtimeArgs": ["-run", "-e", "httpd", ".", "-p", "4000"],
      "port": 4000
    },
    {
      "name": "SCSS watch (npx sass)",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["sass", "--watch", "scss:css"],
      "port": 0
    }
  ]
}
